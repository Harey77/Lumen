# Copy to apps/web/.env and fill in. Never commit the real file.
# Server-side only: the browser never sees these values.

# Anthropic API key for the AI tutor (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: model for the tutor (default claude-opus-5-5)
# LUMEN_MODEL=claude-opus-5-5

# Optional: port for "corepack pnpm start" (default 4173)
# PORT=4173

# Optional: set to 1 if you signed in with "ant auth login" instead of using an API key
# LUMEN_ASSUME_CREDENTIALS=1

# Accounts (Supabase Auth). Public values: the anon / publishable key is safe in the browser.
# Never put the service-role key here. Rebuild after changing these (they are read at build time).
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
